[Desktop Entry]
Type=Application
Name=Linstack
GenericName=Android Container
GenericName[ru]=Контейнер с Android
Exec=linstack
Comment=Run Android apps in a containerized environment.
Comment[ru]=Запуск Android-приложений в изолированном контейнере.
Icon=linstack
Categories=X-LinStack-App;Utility;
Actions=stop;initialize;
X-Purism-FormFactor=Workstation;Mobile;

[Desktop Action stop]
Name=Stop Linstack
Name[ru]=Остановить Linstack
Exec=linstack session stop
Icon=linstack

[Desktop Action initialize]
Name=Initialize Linstack
Name[ru]=Инициализировать Linstack
Exec=linstack init --client
